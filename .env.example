# ===========================================
# Shopify App Configuration
# ===========================================
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"
SHOPIFY_APP_URL="https://your-app-url.fly.dev"
SHOPIFY_APP_HANDLE="your-app-handle"
SCOPES="write_products,read_products,write_inventory,read_inventory"

# Optional: custom shop domain for development
# SHOP_CUSTOM_DOMAIN=""

# ===========================================
# Shopify App Pricing
# ===========================================
# Required for Shopify App Pricing plan reconciliation.
SHOPIFY_PARTNER_ORG_ID="your-partner-organization-id"
SHOPIFY_PARTNER_ACCESS_TOKEN="your-partner-api-access-token"

# Copy these exact handles from the Shopify App Pricing plans in Partner Dashboard.
SHOPIFY_PLAN_HANDLE_FREE="free"
SHOPIFY_PLAN_HANDLE_BASIC="basic"
SHOPIFY_PLAN_HANDLE_PRO="pro"
SHOPIFY_PLAN_HANDLE_ENTERPRISE="enterprise"

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://shopify_sync:shopify_sync_dev@localhost:5432/store_sync"

# ===========================================
# Redis (for BullMQ job queues)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# Security
# ===========================================
# IMPORTANT: Generate a random 32+ character key for production
# Example: openssl rand -hex 16
ENCRYPTION_KEY="change-me-to-a-random-32-char-key!"

# ===========================================
# Optional
# ===========================================
# LOG_LEVEL=debug  # debug | info | warn | error
# NODE_ENV=development
